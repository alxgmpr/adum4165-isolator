	(text "CC current-advertisement sensing (GND1) -- design notes:"
		(at 45 10.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0164eb4b-83ca-4b52-827d-eba278dc85b7")
	)
	(text "- V_REF = 0.66 V, from a VBUS_HOST divider (R3/R4). This is the USB Type-C sink threshold for a 1.5 A source"
		(at 45 13.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0c335abd-9c39-4131-bb41-4edc136be9bb")
	)
	(text "  advertisement (Rp/CC voltage band per USB-PD/Type-C spec). CC1/CC2 above this level means the host is advertising"
		(at 45 15.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "00772547-5ba9-4402-a3c0-167e06acc44c")
	)
	(text "  >=1.5 A."
		(at 45 18.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5c9b3ae6-f09b-4ebd-9fb1-2732dc3a1b4f")
	)
	(text "- The reference MUST stay on VBUS_HOST, never on an isolated rail or anything downstream of EN/HOST_PWR_OK. The"
		(at 45 21.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "fcf7ca51-0899-4a00-824d-09416dab48eb")
	)
	(text "  comparison result is what starts the converter; a reference derived from the converter's own output is a latch-up by"
		(at 45 23.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "76d4cb17-23eb-40e5-84a2-c0d7eb6a02ed")
	)
	(text "  construction."
		(at 45 26.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e88f9f84-a907-4761-bc16-07d9f8a36c5e")
	)
	(text "- On an e-marked cable, one CC line carries VCONN at ~5 V, which reads as a false high (>0.66 V) at the unused"
		(at 45 29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ad0910e3-395f-48b6-99c0-ed3e910dbb56")
	)
	(text "  comparator input. This is benign: VCONN only appears alongside cables/sources rated for high current, and the wire-"
		(at 45 31.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0518bf7f-8217-4c6c-a42d-cbc4ed2822ae")
	)
	(text "  OR only needs ONE CC line correct to assert. A false trigger here never asserts on a low-power host."
		(at 45 34.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1ba1b6da-2144-454a-87a5-dfeb2f926d8e")
	)
	(text "- Q1 (2N7002) inverts CC_DET_L to drive HOST_PWR_OK active-high: gate=CC_DET_L, source=GND1, drain=HOST_PWR_OK, pulled"
		(at 45 151.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d65cc424-f27f-4e48-8c99-2c68750ce504")
	)
	(text "  up by R_EN (R6) to VBUS_HOST. HOST_PWR_OK feeds SN6505B.EN in Task 5."
		(at 45 153.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b97f3f80-49c9-4dda-b706-dcc43c3b99f4")
	)
	(text "- R_EN sizing is not a guess: SN6505B EN leakage is 20 uA max against a 0.7*VCC threshold, so R_EN <="
		(at 45 156.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9c0b62a9-5a6f-43db-b3ed-ab2608e042a6")
	)
	(text "  0.3*VBUS(min)/20uA = 71k. R6 = 10k gives EN ~4.55 V against a 3.325 V threshold (1.225 V margin). 100k here would"
		(at 45 167.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7de9eea6-5cf3-4371-8496-c63112e6d4b6")
	)
	(text "  fail (~2.75 V, below threshold)."
		(at 45 174.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a4da9ffd-e206-4309-a3a9-1db692360eda")
	)
	(text "- Status LED D2 lights on INSUFFICIENT host power: Q2's gate reads CC_DET_L directly (already active-high for"
		(at 45 177.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5b766f6a-3c6e-45d7-87f8-2212dce29b0d")
	)
	(text "  insufficient, no extra inverter needed) and sinks D2+R9 from VBUS_HOST when on."
		(at 45 180.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2306adcd-6a2c-4552-bc83-da29ac35353a")
	)
	(text "- Comparators (U3, TLV7042) are wired INVERTING: CC -> IN-, V_REF -> IN+. Open-drain outputs OUTA/OUTB wire-OR onto"
		(at 45 42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "bb3a4650-4a2c-424b-8f0d-303e24c2b45d")
	)
	(text "  CC_DET_L through R5 (100k to VBUS_HOST): CC_DET_L is LOW when EITHER CC line exceeds 0.66 V (adequate host power),"
		(at 45 44.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "497ac9fe-ba04-465b-87a2-a996ad58cc09")
	)
	(text "  HIGH otherwise."
		(at 45 47.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "fbffe4e8-da09-46b6-86e0-8658ceb8e6e5")
	)
