		(uuid "2452fdbe-1597-4f94-b0c7-a4070be1d7fd")
	)
	(text "CP2 rule (Table 9-3): CP2=hi,PR1=lo selects IN2; CP2=PR1=lo selects VCOMP (higher wins). CP2(pin3)=STATIC bias from ISO_5V_PRE, 23.7k/10.2k to GND2, never the 3A detect."
		(exclude_from_sim no)
		(at 185 15 0)
		(effects
